{
    "name": "mirotalkbro",
    "version": "1.4.51",
    "description": "P2P and SFU WebRTC audio, video and screen live broadcast",
    "main": "app/server.js",
    "scripts": {
        "lint": "npx prettier --write .",
        "build:mediasoup-client": "npx esbuild node_modules/mediasoup-client/lib/index.js --bundle --minify --format=iife --global-name=mediasoupClient --outfile=public/js/mediasoup-client.js --platform=browser",
        "postinstall": "npm run build:mediasoup-client",
        "start": "node app/server.js",
        "start-dev": "nodemon app/server.js",
        "test": "echo \"Error: no test specified\" && exit 1",
        "local-tunnel": "cloudflared tunnel --url http://localhost:3016",
        "docker:build": "COMPOSE_DOCKER_CLI_BUILD=1 DOCKER_BUILDKIT=1 docker build --tag mirotalk/bro:latest .",
        "docker:rmi": "docker images |grep '<none>' |awk '{print $3}' |xargs docker rmi",
        "docker:push": "docker push mirotalk/bro:latest",
        "docker:pull": "docker pull mirotalk/bro:latest",
        "docker:rmc": "docker container rm mirotalk --force",
        "docker:run": "docker run -d -p 3016:3016 --name mirotalk mirotalk/bro:latest",
        "docker:run-local": "docker run --rm -it -p 3016:3016 --name mirotalk mirotalk/bro:latest",
        "docker:rune": "docker run -d -p 3016:3016 -v .env:/src/.env:ro --name mirotalk mirotalk/bro:latest",
        "docker:rune-local": "docker run --rm -it -p 3016:3016 -v .env:/src/.env:ro --name mirotalk mirotalk/bro:latest",
        "docker:run-vm": "docker run -d -p 3016:3016 -v .env:/src/.env:ro -v ./app/:/src/app/:ro -v ./public/:/src/public/:ro --name mirotalk mirotalk/bro:latest",
        "docker:run-vm-local": "docker run --rm -it -p 3016:3016 -v .env:/src/.env:ro -v ./app/:/src/app/:ro -v ./public/:/src/public/:ro --name mirotalk mirotalk/bro:latest",
        "docker:start": "docker start mirotalk",
        "docker:stop": "docker stop mirotalk"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/miroslavpejic85/mirotalkbro"
    },
    "keywords": [
        "WebRTC",
        "Broadcast",
        "Live streaming",
        "Live broadcasting",
        "SocketIO"
    ],
    "author": "Miroslav Pejic",
    "license": "AGPLv3",
    "dependencies": {
        "@ngrok/ngrok": "1.7.0",
        "@sentry/node": "^11.2.0",
        "compression": "^1.8.2",
        "cors": "^2.8.6",
        "dotenv": "^18.0.5",
        "express": "^5.2.1",
        "express-openid-connect": "^3.4.0",
        "helmet": "^8.3.0",
        "httpolyglot": "0.1.2",
        "js-yaml": "^5.4.2",
        "mediasoup": "^3.28.0",
        "mediasoup-client": "^3.24.4",
        "socket.io": "^4.8.4",
        "swagger-ui-express": "5.0.1",
        "uuid": "~14.0.2"
    },
    "devDependencies": {
        "esbuild": "^0.28.2",
        "node-fetch": "^3.3.2",
        "nodemon": "^3.1.14",
        "prettier": "3.9.9"
    }
}
